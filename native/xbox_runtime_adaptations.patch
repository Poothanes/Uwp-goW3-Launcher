 #define DIRECT_ALIGNMENT UINT64_C(0x4000)
 #define PAGE_ALIGN UINT64_C(0x1000)
 #define RETAIL_POOL_MB UINT64_C(5056)
-#define MAX_POOL_MB UINT64_C(16384)
+#define MAX_POOL_MB UINT64_C(16384) /* Use GOW3_DMEM_MB=2560 on Xbox Series S */
 #define FLEX_BASE UINT64_C(0x1080000000)
-#define FLEX_SPAN (UINT64_C(1024)*1024*1024)
+#define FLEX_SPAN (getenv("GOW3_MODULE_DLL") ? (UINT64_C(256)*1024*1024) : (UINT64_C(1024)*1024*1024))
 #define LOW_BASE  UINT64_C(0x10c0000000)
