<Page
  x:Class="GoW3Installer.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="#120808"
  RequestedTheme="Dark"
  XYFocusKeyboardNavigation="Enabled">
  <Page.Resources>
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="#1E1010" />
      <Setter Property="BorderBrush" Value="#5C2323" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#B82929" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E5A93C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="ActionButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#2D1717" />
      <Setter Property="Foreground" Value="#F5E9E2" />
      <Setter Property="BorderBrush" Value="#6E2E2E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
  </Page.Resources>

  <Grid Padding="36,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Background="#7A1C1C" BorderBrush="#E5A93C" BorderThickness="1" CornerRadius="4" Padding="10,3">
            <TextBlock Text="XBOX SERIES S | X  UWP NATIVO" FontSize="11" FontWeight="Bold" Foreground="#F7D78C" CharacterSpacing="80" />
          </Border>
          <Border Background="#2B1616" CornerRadius="4" Padding="10,3">
            <TextBlock x:Name="TitleIdBadge" Text="CUSA01715 / CUSA01623" FontSize="11" FontWeight="SemiBold" Foreground="#DFC2B4" />
          </Border>
        </StackPanel>
        <TextBlock Text="GOD OF WAR III REMASTERED" FontSize="30" FontWeight="Bold" Foreground="#F5E9E2" Margin="0,6,0,2" />
        <TextBlock x:Name="SubtitleText" Text="Launcher UWP + Transferencia Wi-Fi Directa + Preparador Nativo ELF/SELF para Xbox Series S" Foreground="#C4A69A" FontSize="14" />
      </StackPanel>
      <Border Grid.Column="1" Background="#251212" BorderBrush="#6E2E2E" BorderThickness="1" CornerRadius="8" Padding="16,10" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="ESTADO DEL JUEGO" FontSize="11" FontWeight="Bold" Foreground="#E5A93C" />
          <TextBlock x:Name="StateBadgeText" Text="Pendiente de importar" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,0" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Main Content -->
    <Grid Grid.Row="1" ColumnSpacing="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left Column: Actions -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="10">
              <TextBlock Text="1. EJECUCIÓN Y PREPARACIÓN" FontSize="12" FontWeight="Bold" Foreground="#E5A93C" CharacterSpacing="60" />
              <Button x:Name="PlayButton" Content="▶  Jugar God of War III" Style="{StaticResource PrimaryButtonStyle}" Click="PlayGame" />
              <Button x:Name="PrepareButton" Content="⚙  Preparar y Vincular Juego (en Xbox)" Style="{StaticResource ActionButtonStyle}" Click="PrepareGame" />
              <Button x:Name="VerifyButton" Content="✔  Verificar Integridad SHA-256" Style="{StaticResource ActionButtonStyle}" Click="VerifyGame" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="10">
              <TextBlock Text="2. TRANSFERIR JUEGO (SIN DUPLICAR EN PC)" FontSize="12" FontWeight="Bold" Foreground="#E5A93C" CharacterSpacing="60" />
              <Button x:Name="WifiButton" Content="📶  Transferir Carpeta por Wi-Fi (Recomendado)" Style="{StaticResource PrimaryButtonStyle}" Background="#8C2222" Click="StartWifiTransfer" />
              <Button x:Name="ImportFolderButton" Content="📁  Importar Carpeta desde USB (CUSA01715)" Style="{StaticResource ActionButtonStyle}" Click="ImportFolder" />
              <Button x:Name="ImportZipButton" Content="📦  Importar Archivo .ZIP desde USB" Style="{StaticResource ActionButtonStyle}" Click="ImportZip" />
              <Button x:Name="CancelButton" Content="✖  Cancelar Operación Actual" Style="{StaticResource ActionButtonStyle}" Click="CancelActiveOperation" Visibility="Collapsed" />
              <Button x:Name="DeleteButton" Content="🗑  Eliminar Archivos Importados" Style="{StaticResource ActionButtonStyle}" Click="DeleteImportedFiles" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Right Column: Status, Wi-Fi QR & Xbox Settings -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

          <!-- Wi-Fi Pairing Card (Visible during Wi-Fi Transfer) -->
          <Border x:Name="WifiPanel" Style="{StaticResource CardStyle}" BorderBrush="#E5A93C" Visibility="Collapsed">
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="8">
                <TextBlock Text="SERVIDOR WI-FI DIRECTO ACTIVO EN TU XBOX" FontSize="13" FontWeight="Bold" Foreground="#E5A93C" />
                <TextBlock Text="Abre esta dirección en el navegador de tu PC (conectada a la misma red):" Foreground="#DFC2B4" TextWrapping="Wrap" />
                <TextBlock x:Name="WifiUrlText" Text="http://192.168.1.100:8077/" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" IsTextSelectionEnabled="True" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                  <TextBlock Text="Código de emparejamiento:" VerticalAlignment="Center" Foreground="#DFC2B4" FontSize="15" />
                  <Border Background="#3A1A1A" BorderBrush="#E5A93C" BorderThickness="1" CornerRadius="6" Padding="14,6">
                    <TextBlock x:Name="WifiCodeText" Text="000000" FontSize="22" FontWeight="Bold" Foreground="#F7D78C" CharacterSpacing="150" />
                  </Border>
                </StackPanel>
                <TextBlock Text="Selecciona tu carpeta CUSA01715 en el navegador de tu PC. Los archivos se transmitirán directo al almacenamiento de la Xbox sin ocupar espacio extra en tu PC." Foreground="#B59B8E" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Background="#FFFFFF" Padding="8" CornerRadius="8" VerticalAlignment="Center">
                <Image x:Name="WifiQrImage" Width="136" Height="136" />
              </Border>
            </Grid>
          </Border>

          <!-- Progress & Log Card -->
          <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="OperationTitleText" Text="Listo" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="" FontSize="14" FontWeight="Bold" Foreground="#E5A93C" />
              </Grid>
              <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0" Height="12" Foreground="#E5A93C" Background="#331818" CornerRadius="4" />
              <TextBlock x:Name="StorageInfoText" Text="Ruta en Xbox: Comprobando almacenamiento..." FontSize="12" Foreground="#B59B8E" />
              <Border Background="#120808" BorderBrush="#3D1919" BorderThickness="1" CornerRadius="6" Padding="12" Height="150">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                  <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" Foreground="#E8D2C5" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>

          <!-- Xbox Series S/X Settings Card -->
          <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="14">
              <TextBlock Text="3. CONFIGURACIÓN GRÁFICA Y PARCHES (XBOX SERIES S / X)" FontSize="12" FontWeight="Bold" Foreground="#E5A93C" CharacterSpacing="60" />
              <Grid ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                  <TextBlock Text="Resolución Interna (Parche XML)" FontSize="13" Foreground="#DFC2B4" />
                  <ComboBox x:Name="ResolutionCombo" HorizontalAlignment="Stretch" SelectionChanged="OnSettingChanged">
                    <ComboBoxItem Content="1280x720" />
                    <ComboBoxItem Content="1600x900" />
                    <ComboBoxItem Content="1920x1080 (Native)" IsSelected="True" />
                    <ComboBoxItem Content="2560x1440" />
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                  <TextBlock Text="Tasa de Fotogramas (FPS)" FontSize="13" Foreground="#DFC2B4" />
                  <ComboBox x:Name="FpsCombo" HorizontalAlignment="Stretch" SelectionChanged="OnSettingChanged">
                    <ComboBoxItem Content="Default (60 FPS)" />
                    <ComboBoxItem Content="60 FPS++" IsSelected="True" />
                    <ComboBoxItem Content="120 FPS++" />
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                  <TextBlock Text="Iconos de Botones en Pantalla" FontSize="13" Foreground="#DFC2B4" />
                  <ComboBox x:Name="GlyphCombo" HorizontalAlignment="Stretch" SelectionChanged="OnSettingChanged">
                    <ComboBoxItem Content="Xbox Series S/X (A / B / X / Y)" Tag="xbox" IsSelected="True" />
                    <ComboBoxItem Content="PlayStation (Cruz / Círculo / Cuadrado / Triángulo)" Tag="ps" />
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                  <TextBlock Text="Presupuesto Memoria Directa (DMEM)" FontSize="13" Foreground="#DFC2B4" />
                  <ComboBox x:Name="DmemCombo" HorizontalAlignment="Stretch" SelectionChanged="OnSettingChanged">
                    <ComboBoxItem Content="2560 MB (Recomendado Xbox Series S)" Tag="2560" IsSelected="True" />
                    <ComboBoxItem Content="3072 MB (Series S Extendido)" Tag="3072" />
                    <ComboBoxItem Content="5056 MB (Xbox Series X / PC)" Tag="5056" />
                  </ComboBox>
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,4,0,0">
                <CheckBox x:Name="SkipIntroCheck" Content="Saltar logos de inicio" IsChecked="True" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                <CheckBox x:Name="NoMotionBlurCheck" Content="Desactivar Motion Blur" IsChecked="False" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                <CheckBox x:Name="NoDofCheck" Content="Desactivar Depth of Field" IsChecked="False" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
